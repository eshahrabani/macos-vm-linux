# macos-vm configuration. Copy to macos-vm.conf and edit, or export as
# environment variables. Every value shown here is the default.

# VM resources
#VCPU=8
#RAM=12G
#DISK_SIZE_G=80

# CPU model for the guest (pinned: works for Big Sur .. macOS 26/Tahoe)
#CPU_MODEL="Skylake-Client,-hle,-rtm,kvm=on,vendor=GenuineIntel,+invtsc,vmware-cpuid-freq=on,+ssse3,+sse4.2,+popcnt,+avx,+aes,+xsave,+xsaveopt,check"

# Display: gtk (window) | vnc (127.0.0.1:5900) | none
#VM_DISPLAY=gtk

# SSH port forwarded from guest to host
#SSH_PORT=2222
#SSH_USER=mac

# Guest NIC MAC address (keep fixed so macOS network config is stable)
#MAC=52:54:00:c9:18:27

# Cap on the macOS major version the installer will resolve (last Intel release)
#MAX_MACOS=26

# SMBIOS identity presented to Apple (generated automatically on first run;
# persisted in data/smbios.conf). SMBIOS_MODEL switches the presented model:
# iMac19,1 (default) or iMac20,1 (Tahoe-supported — try this if Apple ID
# sign-in still fails on iMac19,1). The SERIAL/MLB/UUID overrides are for
# advanced use only — a real machine's serial is the #1 Apple account-flag
# vector, and ALLOW_REAL_SERIAL=1 is required for `macos-vm smbios set`.
#SMBIOS_MODEL=iMac19,1
#SMBIOS_SERIAL=
#SMBIOS_MLB=
#SMBIOS_UUID=
#ALLOW_REAL_SERIAL=0

# Everything VM-related lives here (downloaded images, disk, logs)
#DATA_DIR=data

# Physical iPhone forwarded into the guest for Xcode development, VID:PID.
# Default 05ac:12a8 = iPhone in normal mode, attached at boot when plugged in.
# Uses a dedicated usb-ehci controller (macOS's XHCI driver can't enumerate
# iOS devices on QEMU's xhci). Use 05ac:any to also catch recovery/DFU
# re-enumeration (also forwards other Apple USB accessories). Empty disables
# passthrough. Hotplug via `macos-vm usb attach|detach` — stop the host's
# gvfs-afc-volume-monitor first or QEMU can't claim the device.
#USB_PASSTHROUGH=05ac:12a8

# --- arm64 macOS (experimental research path, vmapple + TCG) ---
# Which provisioned version `macos-vm arm64 run` boots by default (13|14|15|26)
#ARM64_VERSION=13
#ARM64_VCPU=8
#ARM64_RAM=8G
# SSH port for the arm64 guest (separate from SSH_PORT so both VMs can coexist)
#ARM64_SSH_PORT=2223
#ARM64_MAC=52:54:00:76:61:70
# Extra guest boot-args (ladder debugging): e.g. ARM64_BOOT_ARGS="debug=0x14e"
